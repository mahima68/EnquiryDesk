              {
                "name": "iterationsFromHistoryCount",
                "type": "number",
                "label": "Maximum conversation history"
              },
              {
                "name": "timeout",
                "type": "number",
                "label": "Step timeout",
                "validate": {
                  "min": 120,
                  "max": 600
                }
              },
              {
                "name": "aiCompactionEnabled",
                "type": "boolean",
                "label": "Enable compaction",
                "required": true
              }
            ]
          },
          {
            "name": "outputType",
            "type": "select",
            "label": "Response format",
            "required": true,
            "validate": {
              "enum": [
                "text",
                "make-schema",
                "udt-schema"
              ]
            }
          }
        ]
      },
